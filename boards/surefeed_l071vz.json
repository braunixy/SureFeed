{
  "build": {
    "cpu": "cortex-m0plus",
    "extra_flags": "-DSTM32L0 -DSTM32L071xx",
    "f_cpu": "32000000L",
    "mcu": "stm32l071vzt6",
    "product_line": "STM32L071xx"
  },
  "debug": {
    "default_tools": [
      "blackmagic"
    ],
    "jlink_device": "STM32L071VZ",
    "onboard_tools": [
      "blackmagic"
    ],
    "openocd_target": "stm32l0",
    "svd_path": "STM32L07x.svd"
  },
  "frameworks": [
    "cmsis",
    "stm32cube"
  ],
  "name": "SureFeed Cat Feeder (STM32L071VZT6)",
  "url": "https://github.com/braunixy/SureFeed",
  "vendor": "Sure Petcare",
  "upload": {
    "maximum_ram_size": 20480,
    "maximum_size": 196608,
    "protocol": "blackmagic",
    "protocols": [
      "blackmagic",
      "stlink",
      "jlink"
    ]
  }
}

